<h1>Games</h1>
<p>Pick a game to practice. Everything runs in your browser — no downloads, no accounts, no ads.</p>

<div class="card-grid">
  {% for game in collections.games %}
  <a class="card" href="{{ game.url }}">
    <h3>{{ game.data.title }}</h3>
    <p>{{ game.data.cardBlurb }}</p>
  </a>
  {% endfor %}
</div>
