<!-- Same source-of-truth data file the strategy chart page reads at build
     time (src/_data/blackjackStrategy.js) -- loaded here as a plain script
     so trainer.js checks answers against the identical decision table. -->
<script src="/games/blackjack/strategy.js"></script>

<div class="app">
  <h1 class="page-title">Blackjack Strategy Trainer</h1>
  <p class="no-real-money">Practice only -- no real money, ever.</p>

  <p class="strategy-link"><a href="/strategy/blackjack/basic-strategy/">View the full Blackjack Basic Strategy Chart →</a></p>

  <div class="statusbar">
    <div class="sb-cell">
      <span class="sb-k">Type</span>
      <b id="scType">—</b>
    </div>
    <div class="sb-cell">
      <span class="sb-k">Correct</span>
      <b id="scoreLine">0 / 0</b>
    </div>
    <div class="sb-cell">
      <span class="sb-k">Accuracy</span>
      <b id="accuracyLine">0%</b>
    </div>
  </div>

  <div class="table">
    <div class="dealer-area">
      <div class="seat-label">Dealer Shows</div>
      <div class="hand-total" id="scDealer">—</div>
    </div>
    <div class="player-area">
      <div>
        <div class="seat-label">Your Hand</div>
        <div class="hand-total" id="scHand">—</div>
      </div>
    </div>
  </div>

  <div id="feedback" class="trainer-feedback hidden"></div>

  <div class="action-bar" id="actionBar">
    <button class="btn-roll" id="hitBtn">Hit</button>
    <button class="btn-roll" id="standBtn">Stand</button>
    <button class="btn-outline" id="doubleBtn">Double</button>
    <button class="btn-outline hidden" id="splitBtn">Split</button>
  </div>

  <div class="new-hand-wrap">
    <button class="btn-roll hidden" id="nextBtn">Next Scenario →</button>
  </div>

  <p class="strategy-link"><a href="/games/blackjack/">Play Free Blackjack →</a></p>
</div>
