<!-- Single source of truth for every payout/odds number craps.js uses —
     see src/_data/odds.js. Must load before craps.js. -->
<script src="/games/craps/odds.js"></script>

<div class="overlay" id="setupOverlay">
  <div class="overlay-box">
    <h2 id="overlayTitle">Welcome to Craps</h2>
    <p id="overlayText">Set your starting bankroll to begin.</p>
    <input type="number" id="overlayInput" min="1" step="1" value="200" inputmode="numeric">
    <div class="overlay-buttons">
      <button class="btn-outline" id="overlayCancel" style="display:none;">Cancel</button>
      <button class="btn-roll" id="overlayConfirm">Start</button>
    </div>
  </div>
</div>

<div class="sheet-wrap hidden" id="betSheet">
  <div class="sheet-backdrop" id="sheetBackdrop"></div>
  <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
    <div class="sheet-grip"></div>
    <div class="sheet-head">
      <h3 id="sheetTitle">Number</h3>
      <button class="sheet-close" id="sheetClose" aria-label="Close">&times;</button>
    </div>
    <div class="sheet-body" id="sheetBody"></div>
  </div>
</div>

<div class="app">
  <h1 class="page-title">CRAPS</h1>
  <p class="no-real-money">Practice only — no real money, ever.</p>

  <div class="statusbar">
    <div class="sb-cell">
      <span class="sb-k">Bankroll</span>
      <b id="bankroll">$0.00</b>
    </div>
    <div class="sb-cell">
      <span class="sb-k">Net</span>
      <b id="net">$0.00</b>
    </div>
    <div class="sb-cell sb-point">
      <span class="sb-k">Point</span>
      <b id="pointDisplay">OFF</b>
    </div>
  </div>

  <div id="notice"></div>

  <div class="roll-history-wrap">
    <span class="chip-label">History</span>
    <div class="roll-history" id="rollHistory"></div>
  </div>

  <div class="bet-opts">
    <div class="mode-toggle" id="modeToggle">
      <span class="chip-label">Number bets</span>
      <label><input type="radio" name="numMode" value="place" checked> Place</label>
      <label><input type="radio" name="numMode" value="buy"> Buy</label>
    </div>
    <label class="let-it-ride"><input type="checkbox" id="letItRide"> Let it ride <span class="hint">(keep Place/Buy/Hardway bets up after a win)</span></label>
  </div>

  <div class="table">

    <div class="row lines">
      <div class="bet-strip" id="passLine"></div>
      <div class="bet-strip dont" id="dontPass"></div>
    </div>

    <div class="row lines">
      <div class="bet-strip come" id="comeStrip"></div>
      <div class="bet-strip come dont" id="dontComeStrip"></div>
    </div>

    <div class="row numbers" id="numberRow"></div>

    <div class="row onetime">
      <div class="bet-box" id="field"></div>
      <div class="bet-box" id="anySeven"></div>
      <div class="bet-box" id="anyCraps"></div>
    </div>

    <div class="row hardways" id="hardRow"></div>

  </div>

  <div class="table-actions">
    <button class="btn-outline" id="toggleWorkingBtn">Bets Off</button>
    <button class="btn-outline" id="clearBetsBtn">Clear All Bets</button>
    <button class="btn-outline" id="resetBtn">Reset Bankroll</button>
  </div>

  <div class="actionbar">
    <div class="chip-strip">
      <span class="chip-label">Chip</span>
      <div id="chipSelector"></div>
    </div>
    <div class="roll-group">
      <div class="mini-dice">
        <div class="die" id="die1">-</div>
        <div class="die" id="die2">-</div>
      </div>
      <div class="roll-total" id="rollTotal">Roll the dice to begin</div>
      <button class="btn-roll" id="rollBtn">ROLL</button>
    </div>
  </div>

  <div class="log" id="log"></div>

  <details class="legend">
    <summary>Bet reference</summary>
    <ul>
      <li><b>Pass Line</b> — wins on 7/11 come-out, loses on 2/3/12; then wins if point repeats before a 7. Pays 1:1.</li>
      <li><b>Don't Pass</b> — opposite of Pass Line, pushes on 12. Pays 1:1.</li>
      <li><b>Come / Don't Come</b> — same as Pass/Don't Pass but placed after the point is on; travels to its own number.</li>
      <li><b>Odds</b> — true-odds side bet behind Pass/Don't Pass/Come/Don't Come. No house edge. Max is {{ odds.oddsMult[4] }}x on 4/10, {{ odds.oddsMult[5] }}x on 5/9, {{ odds.oddsMult[6] }}x on 6/8 (times your base bet).</li>
      <li><b>Place</b> — bet a number directly, wins if it repeats before 7. Pays {{ odds.placeOddsStr[4] }} (4/10), {{ odds.placeOddsStr[5] }} (5/9), {{ odds.placeOddsStr[6] }} (6/8).</li>
      <li><b>Buy</b> — same as Place but pays true odds ({{ odds.trueOddsStr[4] }} / {{ odds.trueOddsStr[5] }} / {{ odds.trueOddsStr[6] }}) minus a {{ odds.buyCommissionPct }}% commission charged upfront.</li>
      <li><b>Field</b> — one-roll bet, wins on 2,3,4,9,10,11,12. Pays double on 2, triple on 12, even money otherwise.</li>
      <li><b>Any Seven</b> — one-roll, wins on 7. Pays {{ odds.anySevenPayStr }}.</li>
      <li><b>Any Craps</b> — one-roll, wins on 2,3,12. Pays {{ odds.anyCrapsPayStr }}.</li>
      <li><b>Hardways</b> — number rolls as a double (e.g. 3+3) before a 7 or before that number rolls "easy". Hard 4/10 pay {{ odds.hardPay[4] }}:1, Hard 6/8 pay {{ odds.hardPay[6] }}:1.</li>
    </ul>
  </details>

  <p>
    Craps is a dice game built around one shooter and one simple loop: the come-out
    roll either wins, loses, or sets a point that the shooter then has to repeat before
    a 7 shows up. Every bet on the layout is a wager on how that loop plays out, priced
    off the fixed odds of two dice.
  </p>
  <p class="strategy-link"><a href="/strategy/craps/how-to-play/">New to craps? Read the full how-to-play guide →</a></p>

  <p class="strategy-link"><a href="/strategy/craps/">Read the full craps strategy guides →</a></p>
</div>
