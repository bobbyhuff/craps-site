<div class="app">
  <h1 class="page-title">Free Baccarat Table</h1>

  <div class="overlay" id="setupOverlay">
    <div class="overlay-box">
      <h2 id="overlayTitle">Welcome to Baccarat</h2>
      <p id="overlayText">Set your starting bankroll to begin.</p>
      <input type="number" id="overlayInput" min="1" step="1" value="200" inputmode="numeric">
      <div class="overlay-buttons">
        <button class="btn-outline" id="overlayCancel" style="display:none;">Cancel</button>
        <button class="btn-roll" id="overlayConfirm">Start</button>
      </div>
    </div>
  </div>

  <p class="no-real-money">Practice only -- no real money, ever.</p>

  <div class="statusbar">
    <div class="sb-cell">
      <span class="sb-k">Bankroll</span>
      <b id="bankroll">$0.00</b>
    </div>
    <div class="sb-cell">
      <span class="sb-k">Net</span>
      <b id="net">$0.00</b>
    </div>
    <div class="sb-cell">
      <span class="sb-k">Shoe</span>
      <b id="shoeCount">—</b>
    </div>
  </div>

  <div id="notice"></div>

  <div class="table bacc-table">
    <div class="bacc-hands">
      <div class="bacc-hand-area">
        <div class="seat-label">Player</div>
        <div class="hand" id="playerHand"></div>
        <div class="hand-total" id="playerTotal"></div>
      </div>
      <div class="bacc-hand-area">
        <div class="seat-label">Banker</div>
        <div class="hand" id="bankerHand"></div>
        <div class="hand-total" id="bankerTotal"></div>
      </div>
    </div>
    <div class="bacc-result" id="bacResult"></div>
  </div>

  <div class="bet-area" id="betArea">
    <div class="bacc-bet-row" id="betRow">
      <button class="bacc-bet-spot" id="spotPlayer" data-type="player">
        <span class="bacc-bet-spot-label">Player</span>
        <span class="bacc-bet-spot-pay">{{ baccaratOdds.payoutStr.player }}</span>
        <span class="bacc-bet-spot-amt" id="amtPlayer">—</span>
      </button>
      <button class="bacc-bet-spot" id="spotTie" data-type="tie">
        <span class="bacc-bet-spot-label">Tie</span>
        <span class="bacc-bet-spot-pay">{{ baccaratOdds.payoutStr.tie }}</span>
        <span class="bacc-bet-spot-amt" id="amtTie">—</span>
      </button>
      <button class="bacc-bet-spot" id="spotBanker" data-type="banker">
        <span class="bacc-bet-spot-label">Banker</span>
        <span class="bacc-bet-spot-pay">{{ baccaratOdds.payoutStr.banker }}<sup>*</sup></span>
        <span class="bacc-bet-spot-amt" id="amtBanker">—</span>
      </button>
    </div>
    <p class="bacc-commission-note">*Banker wins pay {{ baccaratOdds.payoutStr.banker }} minus a {{ baccaratOdds.bankerCommissionPct }}% commission.</p>
