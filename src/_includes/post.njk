---
layout: base.njk
---
{% if date %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Article","headline":{{ title | dump | safe }},"datePublished":"{{ date | dateToISO }}","dateModified":"{{ (updated or date) | dateToISO }}","description":{{ description | dump | safe }},"image":"{{ site.url }}{{ ogImage or '/og-image.png' }}","mainEntityOfPage":"{{ site.url }}{{ page.url }}","author":{"@type":"Organization","name":"0stakes","url":"{{ site.url }}/about/"},"publisher":{"@type":"Organization","name":"0stakes","url":"{{ site.url }}/","logo":{"@type":"ImageObject","url":"{{ site.url }}/icon-512.png"}}}
</script>
{% endif %}
<article class="post">
  <h1>{{ title }}</h1>
  {% if date %}<div class="post-date">{{ date | readableDate }}{% if updated %} &middot; Updated {{ updated | readableDate }}{% endif %}</div>{% endif %}
  <div class="post-body">
    {{ content | safe }}
  </div>
  {% include "related.njk" %}
</article>
{% if page.url.startsWith("/strategy/") and not noNewsletter %}
{% set newsletterVariant = "compact" %}
{% include "newsletter.njk" %}
{% endif %}
