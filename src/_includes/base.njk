<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ seoTitle }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

<meta property="og:title" content="{{ seoTitle }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage or '/og-image.png' }}">
<meta property="og:site_name" content="0stakes">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seoTitle }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage or '/og-image.png' }}">

{% if page.url == "/" %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebSite","name":"0stakes","url":"{{ site.url }}/"}
</script>
{% endif %}

{% if breadcrumb %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"}{% for crumb in breadcrumb %},
{"@type":"ListItem","position":{{ loop.index + 1 }},"name":"{{ crumb.name }}","item":"{{ site.url }}{{ crumb.url }}"}{% endfor %}
]}
</script>
{% endif %}

<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" href="/favicon-64.png">
<link rel="apple-touch-icon" href="/icon-512.png">
<meta name="google-site-verification" content="uRxmMD7wGvgqilHl-WR63r0rWE-aJ87MsJVzC-rw1MQ" />
<meta name="theme-color" content="#081810">
<link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/dm-serif-display-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css">
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5395971919392333"
     crossorigin="anonymous"></script>
{% if sharedCss %}<link rel="stylesheet" href="{{ sharedCss }}">{% endif %}
{% if extraCss %}<link rel="stylesheet" href="{{ extraCss }}">{% endif %}
</head>
<body>

{% set accounts = supabase.url and supabase.anonKey %}
{# Only pages that move chips or read accounts load supabase-js (~200 KB) + wallet.js.
   Every other page paints the nav chip from localStorage (see the inline script below). #}
{% set needsWallet = accounts and (page.url.startsWith("/games/") or page.url == "/account/" or page.url == "/leaderboard/") %}
<nav class="site-nav">
  <a class="brand" href="/" aria-label="0stakes home">
    <svg viewBox="0 0 100 100" width="24" height="24" aria-hidden="true">
      <circle cx="50" cy="50" r="44" fill="none" stroke="#35D07A" stroke-width="11" stroke-dasharray="19.97 26.11" stroke-dashoffset="9.99"></circle>
      <circle cx="50" cy="50" r="28" fill="none" stroke="#35D07A" stroke-width="11"></circle>
    </svg>
    <span><b>0</b>stakes</span>
  </a>
  <div class="nav-end">
    {% if accounts %}<a id="wallet-chip" class="wallet-chip" href="/account/" hidden>Log in</a>{% endif %}
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="nav-links" id="nav-links">
    <a href="/games/" {% if page.url.startsWith("/games/") %}class="active"{% endif %}>Games</a>
    <a href="/strategy/" {% if page.url.startsWith("/strategy/") %}class="active"{% endif %}>Strategy</a>
    <a href="/the-pit/" {% if page.url.startsWith("/the-pit/") %}class="active"{% endif %}>The Pit</a>
    {% if accounts %}<a href="/leaderboard/" {% if page.url == "/leaderboard/" %}class="active"{% endif %}>Leaderboard</a>{% endif %}
  </div>
</nav>
<script>
(function () {
  var nav = document.currentScript.previousElementSibling;
  var btn = nav.querySelector('.nav-toggle');
  btn.addEventListener('click', function () {
    var open = nav.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
})();
</script>

<main>
{{ content | safe }}
</main>
{% if tags and ("game" in tags) %}
<script>try { localStorage.setItem('0stakes.lastGame', JSON.stringify({ url: {{ page.url | dump | safe }}, name: {{ title | dump | safe }} })); } catch (e) {}</script>
{% endif %}

<footer class="site-footer">
  <a href="/about/">About</a>
  <a href="/contact/">Contact</a>
  <a href="/privacy/">Privacy</a>
  <a href="/the-pit/">The Pit</a>
  <a href="/#insider">0stakes Insider</a>
  <a href="/feedback/?from={{ page.url | urlencode }}" rel="nofollow">Feedback</a>
  <span class="footer-help">Gambling problem? Call 1-800-GAMBLER or visit <a href="https://www.ncpgambling.org" rel="noopener">ncpgambling.org</a>.</span>
</footer>

{% if needsWallet %}
<script>window.STAKES_SUPABASE = {{ { url: supabase.url, anonKey: supabase.anonKey } | dump | safe }};</script>
<script src="/js/supabase.js"></script>
<script src="/js/wallet.js"></script>
<script src="/js/wallet-bridge.js"></script>
{% elif accounts %}
<script>
/* Light pages: no supabase-js. Paint the nav chip from what wallet.js cached on the last
   game/account page, and from whether supabase-js left a session token behind. */
(function () {
  var chip = document.getElementById('wallet-chip');
  if (!chip) return;
  var ref = {{ supabase.url | dump | safe }}.replace(/^https?:\/\//, '').split('.')[0];
  var signedIn = false, chips = null;
  try {
    signedIn = !!localStorage.getItem('sb-' + ref + '-auth-token');
    chips = localStorage.getItem('0stakes.chips');
  } catch (e) {}
  chip.textContent = !signedIn ? 'Log in'
    : chips !== null && chips !== '' ? Number(chips).toLocaleString('en-US') + ' chips' : 'Account';
  chip.hidden = false;
})();
</script>
{% endif %}
{% if extraJs %}<script src="{{ extraJs }}"></script>{% endif %}
</body>
</html>
