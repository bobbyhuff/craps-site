{# The 0Stakes Insider signup. Include with {% set newsletterVariant = "compact" %} for the
   smaller article version; default is the full homepage version. #}
{% set _nlLive = forms.mailerliteAccountId and forms.mailerliteFormId %}
<section class="newsletter{% if newsletterVariant == 'compact' %} newsletter--compact{% endif %}" {% if newsletterVariant != 'compact' %}id="insider"{% endif %} aria-labelledby="nl-title-{{ newsletterVariant or 'full' }}">
  <p class="newsletter-eyebrow">The 0Stakes Insider</p>
  <h2 class="newsletter-title" id="nl-title-{{ newsletterVariant or 'full' }}">The Math Casinos Hope You Ignore.</h2>
  <p class="newsletter-desc">Get original strategy breakdowns, million-hand simulations, and practical tips for playing smarter. Delivered free.</p>
  {% if newsletterVariant != 'compact' %}
  <ul class="newsletter-benefits">
    <li>Exclusive strategy guides and downloadable cheat sheets.</li>
    <li>New simulations and surprising results.</li>
    <li>Early access to new calculators and games.</li>
  </ul>
  {% endif %}
  {% if _nlLive %}
  <div class="newsletter-form">
    <div class="ml-embedded" data-form="{{ forms.mailerliteFormId }}"></div>
  </div>
  <p class="newsletter-fine">No spam. No betting promotions. Unsubscribe anytime.</p>
  <script>
  /* Load MailerLite's official embed script once, only when this section scrolls near
     the viewport, so visitors who never reach it never contact MailerLite. */
  (function () {
    var box = document.currentScript.parentNode.querySelector('.newsletter-form');
    if (!box || window.__mlRequested) return;
    function load() {
      if (window.__mlRequested) return;
      window.__mlRequested = true;
      (function (w, d, e, u, f, l, n) {
        w[f] = w[f] || function () { (w[f].q = w[f].q || []).push(arguments); };
        l = d.createElement(e); l.async = 1; l.src = u;
        n = d.getElementsByTagName(e)[0]; n.parentNode.insertBefore(l, n);
      })(window, document, 'script', 'https://assets.mailerlite.com/js/universal.js', 'ml');
      window.ml('account', '{{ forms.mailerliteAccountId }}');
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es, o) {
        if (es[0].isIntersecting) { o.disconnect(); load(); }
      }, { rootMargin: '400px' }).observe(box);
    } else { load(); }
  })();
  </script>
  <noscript><p class="newsletter-fine">Turn on JavaScript to join the Insider.</p></noscript>
  {% else %}
  <p class="newsletter-soon" role="status">The Insider signup opens soon.</p>
  {% endif %}
</section>
